# =============================================================================
# URGANCH 1-IMI — ENVIRONMENT VARIABLES
# Vercel: Project > Settings > Environment Variables ga kiriting, so'ng Redeploy.
# Lokal: bu faylni .env.local ga nusxalang.
# =============================================================================

# --- Admin panel (MAJBURIY) ---------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kamida_12_belgili_kuchli_parol
# Ixtiyoriy: sessiya imzosi uchun uzun tasodifiy matn (bo'lmasa paroldan olinadi)
ADMIN_SESSION_SECRET=

# --- Supabase: arizalar va murojaatlar saqlanadigan baza (Vercel uchun MAJBURIY) -
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "service_role" kaliti (anon EMAS). Hech qachon NEXT_PUBLIC_ bilan boshlamang!
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (ixtiyoriy) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=Urganch_IMI
TELEGRAM_ADMIN_CHAT_ID=

NEXT_PUBLIC_SITE_URL=https://www.urganchimi.uz
